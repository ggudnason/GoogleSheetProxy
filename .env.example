# Port the proxy listens on
PORT=3000

# Optional: protect the web interface and settings with a password
# (browser login, any username). The JSON data URLs vMix uses stay open.
# ADMIN_PASSWORD=change-me

# Optional first-run seed: creates one sheet called "main" using this key.
# After the first start, sheets and their settings are managed
# in the web interface and stored in config.json.
# GOOGLE_API_KEY=your-api-key-here
# SPREADSHEET_ID=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXX/edit
# CACHE_SECONDS=5
